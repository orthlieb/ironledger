{
  "id": "yrt",
  "name": "YRT",
  "description": "Yrt homebrew setting — mana, Touched, ritual cantrips, and the Yrt bestiary.",
  "defaultEnabled": false,
  "order": 30,
  "supersedesCultures": {
    "elves": "verdani"
  },
  "supersedesOracles": {
    "region": "yrtRegion",
    "storyRegion": "yrtStoryRegion",
    "settlementType": "yrtSettlementType"
  },
  "moveCategories": [
    { "key": "Yrt", "icon": "yrt-tree", "color": "var(--color-touched)", "order": 200 }
  ],
  "characterFields": [
    {
      "id": "religion",
      "label": "Religion",
      "type": "dropdown",
      "optionsFrom": { "oracle": "yrtReligion", "label": "name" },
      "default": "",
      "roll": {
        "oracle": "yrtReligion",
        "from": "name",
        "column": { "field": "origin", "from": "country" }
      }
    },
    {
      "id": "touched",
      "label": "Touched",
      "type": "dropdown",
      "options": [
        { "id": "pure", "label": "Pure" },
        { "id": "prime", "label": "Prime" },
        { "id": "second", "label": "Second" },
        { "id": "third", "label": "Third" },
        { "id": "feral", "label": "Feral" }
      ],
      "default": "pure",
      "roll": { "oracle": "yrtTouched", "from": "className" },
      "tooltip": "From the Character: Touched oracle. A Pure character cannot use a Touched asset."
    },
    {
      "id": "touchedAnimal",
      "label": "Animal",
      "type": "string",
      "default": "",
      "placeholder": "Animal…",
      "if": [{ "key": "touched", "min": 1 }],
      "roll": { "oracle": "yrtAnimal" },
      "tooltip": "From the Character: Touched Aspect oracle."
    }
  ],
  "infoLink": {
    "label": "YRT",
    "url": "http://yrt.iron-ledger.org"
  }
}
