{
  "name": "@ironledger/api",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "gen:manifest": "node ../../scripts/gen-extensions-manifest.mjs",
    "lint:dsl": "node ../../scripts/lint-dsl.mjs",
    "predev": "npm run gen:manifest && npm run lint:dsl",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx/esm src/main.ts",
    "prebuild": "npm run gen:manifest && npm run lint:dsl && node ../../scripts/gen-yrt-reference.mjs",
    "build": "tsc --project tsconfig.json && node scripts/copy-static.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "migrate": "node --env-file-if-exists=../../.env --import tsx/esm src/db/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx/esm src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "nodemailer": "^8.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "resend": "^4.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
